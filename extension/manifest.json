{
  "manifest_version": 3,
  "name": "modSUTD - share to catalogue",
  "version": "0.1.0",
  "description": "After you submit a SUTD course evaluation, drop your review on modSUTD with one click.",
  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "modSUTD",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "48":  "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://forms.office.com/*",
        "https://forms.office.com/Pages/*",
        "*://*.sutd.edu.sg/*",
        "*://myportal.sutd.edu.sg/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://forms.office.com/*",
    "*://*.sutd.edu.sg/*"
  ],
  "options_page": "options/options.html"
}
