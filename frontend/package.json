{
  "name": "modsutd-frontend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-data.mjs && node scripts/gen-sitemap.mjs",
    "prebuild": "node scripts/sync-data.mjs && node scripts/gen-sitemap.mjs",
    "gen-sitemap": "node scripts/gen-sitemap.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "merge-ready": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e",
    "e2e:ui": "playwright test --ui",
    "flow": "vitest run --config vitest.flow.config.ts",
    "pree2e": "node scripts/check-selectors.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.0.1",
    "leaflet": "^1.9.4",
    "minisearch": "^7.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "ical.js": "^2.2.1",
    "jsdom": "^23.0.1",
    "sass": "^1.69.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
